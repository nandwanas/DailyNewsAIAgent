# === Anthropic API ===
ANTHROPIC_API_KEY=sk-ant-your-key-here
CLAUDE_MODEL=claude-sonnet-4-6

# === NewsAPI ===
NEWSAPI_KEY=your_newsapi_key_here
NEWSAPI_MAX_ARTICLES=30

# === Languages (Indian languages + English) ===
NEWSLETTER_LANGUAGES=en,hi,mr,bn,te,ta,gu,kn,ml,pa,or

# === News Query ===
NEWS_QUERY=agriculture OR farming OR crop OR kisan OR MSP OR "crop price" OR "farm"

# === Output ===
OUTPUT_DIR=./output
LOG_LEVEL=INFO

# === Gmail Delivery ===
GMAIL_RECIPIENT=your@email.com
